# =============================================================================
# Staz AI — Production environment variables (safe template — no real secrets)
# =============================================================================
# Copy each NAME=VALUE pair into Vercel:
#   Project → Settings → Environment Variables → Add / Import
# Apply to: Production + Preview. Redeploy after changes.
#
# Local dev: copy to `.env.local` and fill in real values.
#
# Hosting / build notes (Vercel + Next.js 16):
# - Framework: Next.js (auto-detected)
# - Install: npm install (default)
# - Build: npm run build  →  next build --webpack  (see package.json)
# - Output: Next.js default (no output: "export")
# - Root directory: repo root (where package.json / next.config.ts live)
# - Node: 20.x recommended
# - Crons / www→apex redirects: vercel.json
# - Large body uploads: next.config.ts experimental.proxyClientMaxBodySize
#
# Not used by this codebase: GEMINI_API_KEY (STT/LLM = OpenAI + AssemblyAI).
# =============================================================================

# -----------------------------------------------------------------------------
# Required (core)
# -----------------------------------------------------------------------------

# OpenAI API key — GPT summaries, action items, chat; Whisper STT fallback.
# Get it: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# NextAuth encryption/signing secret (required).
# Generate: openssl rand -base64 32
AUTH_SECRET=

# Public site URL for auth callbacks and absolute links (Production:
#   https://1stazai.com  — no trailing slash).
AUTH_URL=https://1stazai.com

# -----------------------------------------------------------------------------
# Storage & primary STT (strongly recommended for production)
# -----------------------------------------------------------------------------

# Vercel Blob — large audio/video uploads and persisted app data on Vercel.
# Required for files over ~4 MB (multipart client upload).
# Vercel Dashboard → Storage → Blob → Connect to project
BLOB_READ_WRITE_TOKEN=

# AssemblyAI — primary STT, speaker diarization, YouTube / platform URLs.
# Get it: https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=

# Optional shared secret for AssemblyAI → POST /api/webhooks/assemblyai.
# Falls back to AUTH_SECRET when unset.
# ASSEMBLYAI_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Auth — Google OAuth (optional locally; required for Google sign-in)
# -----------------------------------------------------------------------------

# Preferred names (either pair works — see auth-oauth.ts):
# These are for Staz website login — NOT Recall dashboard “Google Logins”.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# NextAuth Alt aliases:
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# Client-visible Google ID (optional; same as GOOGLE_CLIENT_ID if needed):
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# -----------------------------------------------------------------------------
# Live meetings — Recall.ai + cron + email digests
# -----------------------------------------------------------------------------

# Recall.ai — bot joins Zoom / Google Meet / Teams and records (required for auto-join).
# Your workspace region from the dashboard (Aviya → EU Frankfurt) = eu-central-1
# Dashboard: https://eu-central-1.recall.ai/dashboard
# API keys:  https://eu-central-1.recall.ai/dashboard/developers/api-keys
# Webhooks:  https://eu-central-1.recall.ai/dashboard/webhooks
#
# Webhook URL to paste in Recall:
#   https://YOUR_DOMAIN/api/webhooks/recall?token=YOUR_CRON_SECRET
#
# Note: Calendars / Slack Teams / Google Logins in the Recall sidebar are
# configured inside Recall’s dashboard — not as Staz environment variables.
# Staz Google sign-in uses GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above.
RECALL_AI_API_KEY=
RECALL_AI_REGION=eu-central-1
RECALL_WEBHOOK_SECRET=
# Optional override (usually leave empty — derived from RECALL_AI_REGION):
# RECALL_API_BASE_URL=https://eu-central-1.recall.ai/api/v1

# Shared secret for cron + webhook auth (Bearer / ?token=).
# Protects GET /api/cron/live-bots, dispatch, and optional Recall webhook.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# NO leading/trailing spaces (Vercel rejects whitespace in cron header values).
CRON_SECRET=

# Required for email OTP login in production (no silent fallback).
RESEND_API_KEY=
# Verified sender, e.g. Staz AI <noreply@1stazai.com>
RESEND_FROM_EMAIL=

# Dev only: force simulated meeting bot (no Recall).
# MEETING_BOT_SIMULATE=1

# -----------------------------------------------------------------------------
# Billing — PayPal
# -----------------------------------------------------------------------------

# Server-only REST credentials:
# PayPal Developer Dashboard → Apps & Credentials
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "live" production | "sandbox" for testing
PAYPAL_MODE=live

# Browser checkout (same value as PAYPAL_CLIENT_ID):
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Optional — pin the LIVE monthly plan (do not mix Sandbox plan IDs):
# PAYPAL_PRODUCT_ID=
# During Launch Month: first month $9.99 (TRIAL) then $24.90 (REGULAR).
# Prefer pinning so Live checkout never depends on Blob auto-create:
# PAYPAL_LAUNCH_PLAN_ID=
# After campaign ends (or LAUNCH_CAMPAIGN_KILL=1), only regular plan is used:
# PAYPAL_REGULAR_PLAN_ID=
# Alias accepted by the server:
# PAYPAL_PLAN_ID=

# Instant kill-switch for Launch Month UI + PayPal launch plan selection:
# LAUNCH_CAMPAIGN_KILL=1

# Required in live to apply webhook plan changes (cancel / past_due).
# PayPal Dashboard → Webhooks → URL: https://1stazai.com/api/paypal/webhook
# PAYPAL_WEBHOOK_ID=

# -----------------------------------------------------------------------------
# Optional ops / SEO / local tooling
# -----------------------------------------------------------------------------

# Admin dashboard access (comma-separated extras via ADMIN_EMAILS):
# ADMIN_EMAIL=you@example.com
# ADMIN_EMAILS=a@x.com,b@y.com

# Public site URL (SEO, absolute links) if different from AUTH_URL:
# NEXT_PUBLIC_SITE_URL=https://1stazai.com
# NEXT_PUBLIC_APP_URL=https://1stazai.com

# Pro seats without payment (comma-separated emails):
# PRO_GRANTED_EMAILS=

# Path to ffmpeg binary when not using bundled ffmpeg-static:
# FFMPEG_BIN=

# Google Search Console verification:
# GOOGLE_SITE_VERIFICATION=

# Optional AdSense slot id for marketing units:
# NEXT_PUBLIC_ADSENSE_SLOT=

# CI / local when secrets are unavailable (skips @t3-oss env validation):
# SKIP_ENV_VALIDATION=1
