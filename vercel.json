{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.1stazai.com" }],
      "destination": "https://1stazai.com/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/live-bots",
      "schedule": "* * * * *"
    }
  ],
  "build": {
    "env": {
      "YOUTUBE_DL_SKIP_PYTHON_CHECK": "1"
    }
  },
  "functions": {
    "src/app/api/transcribe/from-url/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "src/app/api/transcribe/jobs/[id]/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    },
    "src/app/api/transcribe/jobs/route.ts": {
      "maxDuration": 300,
      "memory": 1024
    }
  }
}
